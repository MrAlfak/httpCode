{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MrAlfak/httpCode/schema/http-code.schema.json",
  "title": "HTTP status code entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","code","type","provider","phrase","description","class","status","source","verified_at"],
  "properties": {
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "code":{"type":"integer","minimum":100,"maximum":999},
    "type":{"enum":["standard","vendor"]},
    "provider":{"type":"string","minLength":1},
    "phrase":{"type":"string","minLength":1},
    "description":{"type":"string","minLength":1},
    "class":{"type":"string","pattern":"^[1-9]xx .+$"},
    "status":{"enum":["active","temporary","unused","obsoleted"]},
    "reference":{"type":"string"},
    "source":{"type":"object","additionalProperties":false,"required":["name","url","quality"],"properties":{"name":{"type":"string","minLength":1},"url":{"type":"string","format":"uri","pattern":"^https://"},"quality":{"enum":["official","vendor","community","historical"]}}},
    "verified_at":{"type":["string","null"],"format":"date"},
    "mdn_link":{"type":["string","null"],"format":"uri"}
  },
  "allOf":[{"if":{"properties":{"type":{"const":"standard"}},"required":["type"]},"then":{"properties":{"provider":{"const":"iana"}},"required":["reference"]}}]
}
